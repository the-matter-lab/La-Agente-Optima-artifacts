def _build_run_pyscf_workflow_docstring() -> str:
    diagram = pyscf_workflow_graph.render()
    return f"""Run PySCF calculations using the workflow graph with dynamic routing capabilities.

Workflow graph (Mermaid):
```mermaid
{diagram}
```

Parameters:
- `summarised_user_query`: Short summary of user intent for routing.
- `identifier_type`: One of `name | smiles | xyz | xyz_filename | conceptual_atoms_iri`.
- `identifier`: Identifier payload based on `identifier_type`.
- `exit_node`: Optional hard-stop node name in the workflow graph.
- `update_graph`: If true, push final `PyscfOutput` and final molecule to KG at graph end.

Notes:
- Dynamic routing is enabled by default.
- Imaginary-frequency handling/re-optimization loops are managed by the workflow graph.
- Optional workflow-control parameters exposed to the main agent:
  - `geometry_max_steps` (default: 100)
  - `freq_threshold` (default: 50.0)
  - `tddft_nstates` (default: 10)
  - `imag_removal_max_attempts` (default: 3)
  - `workflow_timeout_s` (default: None; kill the isolated workflow child after this many seconds)
	"""


def get_pyscf_gpu_executor_mode() -> PyscfGpuExecutorMode:
    mode = os.getenv("AKG_GPU_EXECUTOR", "local").strip().lower()
    if mode not in {"local", "modal"}:
        raise ValueError("AKG_GPU_EXECUTOR must be one of local, modal")
    return mode  # type: ignore[return-value]


def _require_modal_kg_connectivity(
    update_graph: bool,
    deps_obj: Optional[GraficoDeps],
) -> None:
    if not update_graph:
        return
    if deps_obj and deps_obj.sparql_endpoint:
        return
    if os.getenv("SPARQL_ENDPOINT"):
        return
    raise RuntimeError(
        "AKG_GPU_EXECUTOR=modal with update_graph=True requires SPARQL_ENDPOINT "
        "or GraficoDeps.sparql_endpoint inside the Modal function"
    )


def run_pyscf(
    ctx: RunContext[GraficoDeps],
    pyscf_input: PyscfInput,
    summarised_user_query: str,
    exit_node: Optional[str] = None,
    update_graph: bool = False,
    geometry_max_steps: int = 100,
    freq_threshold: float = 50.0,
    tddft_nstates: int = 10,
    imag_removal_max_attempts: int = 3,
    workflow_timeout_s: Optional[float] = None,
) -> list[PyscfOutput]:
    """Run PySCF calculations using the workflow graph with dynamic routing capabilities."""
    print("Running PySCF workflow:")
    # this print statement causes a problem with computed_field in ConceptualAtoms if repr(pyscf_input) is called
    # see issue: https://github.com/jb2197/akg4pyscf/issues/128
    print(f"  - Input: {pyscf_input}")
    print(f"  - Summarised user query: {summarised_user_query}")
    print(f"  - Hard exit node: {exit_node}")
    print(f"  - Update knowledge graph: {update_graph}")
    print(f"  - Geometry max steps: {geometry_max_steps}")
    print(f"  - Frequency threshold: {freq_threshold}")
    print(f"  - TDDFT nstates: {tddft_nstates}")
    print(f"  - Imag. removal max attempts: {imag_removal_max_attempts}")
    print(f"  - Workflow timeout: {workflow_timeout_s}")

    deps_obj = getattr(ctx, "deps", None)
    if deps_obj:
        # Rebuild deps to avoid pickling non-serializable runtime objects.
        deps_obj = GraficoDeps(
            ws_url=deps_obj.ws_url,
            room=deps_obj.room,
            sparql_endpoint=deps_obj.sparql_endpoint,
            service_token=deps_obj.service_token,
        )

    executor_mode = get_pyscf_gpu_executor_mode()
    run_id = ensure_run_id()
    headers = get_context_headers(run_id)
    if executor_mode == "modal":
        _require_modal_kg_connectivity(update_graph, deps_obj)
        try:
            return run_pyscf_on_modal(
                target_module=__name__,
                target_function="_child_run_impl",
                args=(
                    pyscf_input,
                    summarised_user_query,
                    exit_node,
                    update_graph,
                    geometry_max_steps,
                    freq_threshold,
                    tddft_nstates,
                    imag_removal_max_attempts,
                    run_id,
                    -1,
                ),
                kwargs={"deps": deps_obj},
                headers=headers,
            )
        except Exception as e:
            # format_exc() already ends with the exception message, so embedding
            # str(e) separately would duplicate it (large when child stdio is attached).
            tb = traceback.format_exc()
            logfire.error(f"Modal GPU function failed: {e}")
            raise ModelRetry(f"PySCF workflow execution failed: {tb}") from e

    with gpu_session_with_slot() as (gpu_id, slot_id, snapshot):
        logfire.info(
            f"Assigned GPU {gpu_id} slot {slot_id} for this workflow run. Available GPUs: {available_gpu_ids()} | Remaining slots: {snapshot}"
        )
        try:
            return run_in_gpu_process(
                __name__,
                "_child_run_impl",
                gpu_id,
                pyscf_input,
                summarised_user_query,
                exit_node,
                update_graph,
                geometry_max_steps,
                freq_threshold,
                tddft_nstates,
                imag_removal_max_attempts,
                run_id,
                gpu_id,
                headers=headers,
                timeout=workflow_timeout_s,
                deps=deps_obj,
            )
        except Exception as e:
            tb = traceback.format_exc()
            logfire.error(f"GPU child failed: {e}")
            raise ModelRetry(f"PySCF workflow execution failed: {tb}")


