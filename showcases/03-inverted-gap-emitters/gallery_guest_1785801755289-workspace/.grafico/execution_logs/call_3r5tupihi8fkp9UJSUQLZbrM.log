def is_mf_on_gpu(mf) -> bool:
    """Check if a mean-field object is actually running on GPU."""
    return mf.__module__.startswith("gpu4pyscf")


def get_mf_gpu(mf):
    """Get mean-field object on GPU if available."""
    if not CUDA_GPU_AVAILABLE:
        return mf

    if is_mf_on_gpu(mf):
        return mf  # Already on GPU
    else:
        try:
            return mf.to_gpu()
        except (AttributeError, RuntimeError) as e:
            logfire.warning(f"Failed to convert to GPU: {e}")
            return mf


class CompactFrequencyAnalysis(BaseModel):
    """Compact version of frequency analysis results without norm_mode to save LLM API costs"""

    H_tot: Tuple[float, str] = Field(..., description="Total enthalpy with units")
    G_tot: Tuple[float, str] = Field(
        ..., description="Total Gibbs free energy with units"
    )
    freq_wavenumber: NDArray[Shape["*"], float | complex] = Field(  # type: ignore
        ..., description="Frequency wavenumbers in cm^-1"
    )

    @field_validator("freq_wavenumber", mode="before")
    @classmethod
    def _coerce_complex_array(cls, v):
        # workaround for numpydantic not supporting complex arrays directly
        # https://numpydantic.readthedocs.io/en/latest/dtype.html#complex-numbers
        # it gets serialized as list of strings, e.g. ['100.0', '-50.0+20.0j']
        # which could give the following error during model_validate_json:
        # ```
        # ValidationError: 1 validation error for CompactFrequencyAnalysis
        # freq_wavenumber
        # Value error, Invalid dtype! expected float | complex, got <U7 [type=value_error, input_value=['100+0j', '-50+20j', '0j'], input_type=list]
        #     For further information visit https://errors.pydantic.dev/2.11/v/value_error
        # ```
        if isinstance(v, list) and len(v) > 0:
            if isinstance(v[0], str):
                return [complex(x) for x in v]
        return v

    def get_imaginary_frequencies(self, freq_threshold=50.0) -> List[complex]:
        imaginary_freqs = [
            freq
            for freq in self.freq_wavenumber
            if issubclass(type(freq), complex) and freq.imag > freq_threshold
        ]
        return imaginary_freqs

    def has_imaginary_frequencies(self, freq_threshold=50.0) -> bool:
        return any(
            issubclass(type(freq), complex) and freq.imag > freq_threshold
            for freq in self.freq_wavenumber
        )


class FrequencyAnalysis(CompactFrequencyAnalysis):
    """Complete version of frequency analysis results"""

    norm_mode: NDArray[Shape["*, *, 3"], float] = Field(  # type: ignore
        ..., description="Normal mode of the molecule"
    )

    def to_compact_analysis(self) -> "CompactFrequencyAnalysis":
        """Create compact analysis from full FrequencyAnalysis"""
        return CompactFrequencyAnalysis(
            H_tot=self.H_tot,
            G_tot=self.G_tot,
            freq_wavenumber=self.freq_wavenumber,
        )


