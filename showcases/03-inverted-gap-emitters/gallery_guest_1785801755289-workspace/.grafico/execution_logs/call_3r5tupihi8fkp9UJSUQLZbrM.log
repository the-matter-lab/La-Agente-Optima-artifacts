    def build_base_mf(self, mol: gto.Mole) -> scf.hf.SCF:
        """Build the CPU mean-field object before optional GPU conversion."""
        if self.xc_functional is None:
            return scf.RHF(mol) if self.restricted else scf.UHF(mol)

        mf = dft.RKS(mol) if self.restricted else dft.UKS(mol)
        mf.xc = self.xc_functional
        return mf

    def build_smd_solvent(self, mol: gto.Mole) -> pyscf_smd.SMD:
        """Build the CPU SMD object; PySCF upgrades it during `mf.to_gpu()`."""
        solvent_name = "water"
        if self.implicit_solvent is not None:
            solvent_name = SMD_SOLVENT_ALIASES.get(
                self.implicit_solvent.lower(),
                self.implicit_solvent.lower(),
            )

        if solvent_name not in pyscf_smd.solvent_db:
            raise ValueError(f"SMD solvent '{solvent_name}' is not available in PySCF.")
        return pyscf_smd.SMD(mol, solvent=solvent_name)

    @property
    def pyscf_mol(self) -> gto.Mole:
        """Returns a PySCF Mole object from the mean-field calculation.

        This property always returns the mol object associated with the current
        mean-field calculation, ensuring that any computed results (like optimized
        geometries) are preserved. The mol object cannot be set directly to prevent
        loss of calculation results.
        """
        # Always get mol from the mean-field object to ensure we have
        # the mol that contains any calculation results
        return self.pyscf_mf.mol

    @property
    def pyscf_mf(self) -> scf.hf.SCF:
        """Returns a PySCF mean-field object based on the method and restrictions.
        GPU-enabled by default when available.
        """
        if self._mf is None:
            logfire.debug(
                f"Creating PySCF mean-field object for {self.qcmolecule.identifier}"
            )

            # Create initial mol object from QCMolecule
            qcem = self.qcmolecule.to_qcelemental_molecule()
            mol = gto.Mole(
                atom=list(zip(qcem.symbols, qcem.geometry)),
                basis=self.qcmolecule.basis_set,
                charge=qcem.molecular_charge,
                # Spin multiplicity in PySCF is 2S, not 2S + 1
                spin=qcem.molecular_multiplicity - 1,
                unit="Bohr",  # qcelemental uses Bohr by default
            )
            try:
                mol.ecp = self.qcmolecule.basis_set
                mol.build()
            except Exception:
                mol.ecp = None
                mol.build()

            # Build the CPU object first, then let PySCF upgrade the full
            # solvent-wrapped stack to GPU in one pass when the runtime allows it.
            mf = self.build_base_mf(mol)

            # NOTE call `density_fit` here so that it doesn't raise error if running on GPU
            # which might complain if we do `self._mf = mf.density_fit().to_gpu()` after specifying the solvation
