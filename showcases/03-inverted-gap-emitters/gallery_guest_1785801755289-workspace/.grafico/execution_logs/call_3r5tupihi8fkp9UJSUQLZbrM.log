            if self._checkfile_path:
                os.makedirs(os.path.dirname(self._checkfile_path), exist_ok=True)
                mf.chkfile = self._checkfile_path
            mf.verbose = 0

            # Enable GPU and density fitting by default when available
            try:
                self._mf = mf.to_gpu()
                logfire.debug("Mean-field object initialized with GPU acceleration")
            except ImportError:
                self._mf = mf
                logfire.debug(
                    "Mean-field object initialized on CPU (GPU not available)"
                )
        return self._mf

