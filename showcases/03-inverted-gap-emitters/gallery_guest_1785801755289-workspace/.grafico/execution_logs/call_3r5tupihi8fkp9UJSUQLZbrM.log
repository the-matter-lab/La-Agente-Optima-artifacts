            #           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
            #   File ".../lib/python3.12/site-packages/gpu4pyscf/scf/hf.py", line 759, in density_fit
            #     raise RuntimeError(
            #           RuntimeError: It is recommended to call density_fit() before applying a solvent model.
            #           Calling density_fit() after the solvent model may result in incorrect nuclear gradients,
            #           TDDFT, and other methods.
            # ```
            mf = mf.density_fit()

            # add solvation model if specified
            if self.solvation_model == "SMD":
                mf = mf.SMD(self.build_smd_solvent(mol))
            elif bool(self.solvation_model) or bool(self.implicit_solvent):
                mf = mf.PCM()
                if self.solvation_model is not None:
                    mf.with_solvent.method = self.solvation_model
                else:
                    mf.with_solvent.method = "IEF-PCM"
                    logfire.debug("No solvation model specified, defaulting to IEF-PCM")

