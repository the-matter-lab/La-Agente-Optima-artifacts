    },
    {
      "categories": [
        "N16",
        "N17",
        "N202",
        "N295",
        "N321",
        "N404",
        "N440",
        "N450",
        "N477",
        "N642",
        "N672",
        "N682",
        "N689",
        "N693"
      ],
      "name": "node",
      "type": "categorical"
    },
    {
      "categories": [
        "E226",
        "E154",
        "E161"
      ],
      "name": "edge",
      "type": "categorical"
    }
  ],
  "random_seed": 20260812,
