{
  "backend": "baybe",
  "batch_size": 3,
  "description": "BayBE campaign over PORMAKE topology + node building block + edge building block. External evaluator constructs MOFs with PORMAKE and scores Zeo++ pore metrics for Xe/Kr separation.",
  "initial_design_size": 9,
  "max_iterations": 10,
  "max_observations": 30,
  "name": "xe-kr-pormake-mof-baybe",
