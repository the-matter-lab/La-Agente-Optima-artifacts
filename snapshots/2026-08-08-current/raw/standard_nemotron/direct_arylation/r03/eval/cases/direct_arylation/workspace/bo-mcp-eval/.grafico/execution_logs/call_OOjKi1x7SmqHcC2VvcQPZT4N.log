│   ├── evaluator.py                 # Oracle API evaluation logic
│   ├── reporter.py                  # Result extraction & reporting
│   ├── attempt_tracking.py          # Local attempt artifact (JSONL)
│   └── campaign.py                  # Orchestration loop
├── HOW_TO_EXECUTE_CAMPAIGN.md       # This file
