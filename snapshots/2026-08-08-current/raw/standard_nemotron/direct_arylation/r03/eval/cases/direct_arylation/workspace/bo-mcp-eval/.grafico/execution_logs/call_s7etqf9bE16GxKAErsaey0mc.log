    46	def make_idempotency_key(prefix: str, *parts: str) -> str:
    47	    """Generate an idempotency key with prefix, parts, and random suffix."""
    48	    joined = "-".join(p.replace("/", "_") for p in parts if p)
    49	    return f"{prefix}-{joined}-{uuid.uuid4().hex[:10]}"
