    52	def check_stop_file(stop_file: Path) -> bool:
    53	    """Check if stop file exists; if so, delete it and return True."""
    54	    if stop_file.exists():
    55	        try:
    56	            stop_file.unlink()
    57	            return True
    58	        except OSError:
    59	            return True
    60	    return False
