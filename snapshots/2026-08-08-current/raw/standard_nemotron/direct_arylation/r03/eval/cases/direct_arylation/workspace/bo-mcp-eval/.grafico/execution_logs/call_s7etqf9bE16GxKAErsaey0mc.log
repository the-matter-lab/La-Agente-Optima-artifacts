    87	def submit_results(
    88	    client: BoMcpClient,
    89	    campaign_id: str,
    90	    results: list[dict[str, Any]],
    91	    *,
    92	    force: bool = False,
    93	) -> list[str]:
    94	    """
    95	    Submit successful evaluation results to BO-MCP.
    96	
    97	    Args:
    98	        client: BO-MCP client
    99	        campaign_id: Campaign ID
   100	        results: List of evaluation result dicts (only successful ones)
   101	        force: Whether to force submission (for replicates)
   102	
   103	    Returns:
   104	        List of result IDs from BO-MCP
   105	    """
   106	    if not results:
   107	        return []
   108	
   109	    # Build BO-MCP result submission payload
   110	    bo_results = []
   111	    for r in results:
   112	        if r["status"] != "success" or r["yield"] is None:
   113	            continue
   114	        candidate = r["candidate"]
   115	        if not validate_candidate(candidate):
   116	            log_alert(f"Skipping invalid candidate for submission: {candidate}")
   117	            continue
   118	
   119	        bo_results.append({
   120	            "parameter_values": candidate,
   121	            "objective_values": {"yield": r["yield"]},
   122	            "metadata": {
   123	                "notes": f"oracle_api; elapsed_s={r.get('elapsed_s', 0.0):.3f}",
   124	            },
   125	        })
   126	
   127	    if not bo_results:
   128	        return []
   129	
   130	    idempotency_key = make_idempotency_key("submit", campaign_id, str(len(bo_results)))
   131	    try:
   132	        response = client.submit_results(
   133	            campaign_id,
   134	            results=bo_results,
   135	            idempotency_key=idempotency_key,
   136	            force=force,
   137	        )
   138	        result_ids = response.get("result_ids", [])
   139	        log_event(f"Submitted {len(result_ids)} results to BO-MCP")
   140	        return result_ids
   141	    except BoMcpOperationError as e:
   142	        if "duplicate" in str(e.payload).lower() and not force:
   143	            log_alert(f"Duplicate result rejected; consider force=True for replicates: {e}")
   144	        raise
   145	    except BoMcpClientError as e:
   146	        log_alert(f"Failed to submit results: {e}")
   147	        raise
