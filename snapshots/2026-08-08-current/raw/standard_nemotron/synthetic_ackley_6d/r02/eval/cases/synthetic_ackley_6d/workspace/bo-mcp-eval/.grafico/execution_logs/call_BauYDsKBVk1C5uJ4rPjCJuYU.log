from __future__ import annotations

import json

import pytest

from domains.bo_mcp.client import (
    BoMcpClient,
    BoMcpClientError,
    BoMcpOperationError,
)


class _FakeResponse:
    def __init__(
        self,
        *,
        status_code: int = 200,
        payload: dict | list | None = None,
        content: bytes = b"",
        content_type: str = "application/json",
        text: str = "",
    ) -> None:
        self.status_code = status_code
        self._payload = payload
        self.content = content
        self.headers = {"Content-Type": content_type}
        self.text = text or (json.dumps(payload) if payload is not None else "")

    def json(self):
        if self._payload is None:
            raise ValueError("no JSON")
        return self._payload


class _FakeSession:
    def __init__(self, response: _FakeResponse) -> None:
        self.response = response
        self.headers: dict[str, str] = {}
        self.calls: list[dict] = []

    def request(self, method, url, **kwargs):
        self.calls.append({"method": method, "url": url, **kwargs})
        return self.response


def _client(response: _FakeResponse) -> tuple[BoMcpClient, _FakeSession]:
    client = BoMcpClient(base_url="http://api:8000", api_key="key-123")
    fake = _FakeSession(response)
    fake.headers = dict(client.session.headers)
    client.session = fake
    return client, fake


def test_from_env_requires_base_url(monkeypatch):
    monkeypatch.delenv("BO_MCP_API_URL", raising=False)
    monkeypatch.setenv("BO_MCP_API_KEY", "key-123")
    with pytest.raises(BoMcpClientError, match="BO_MCP_API_URL"):
        BoMcpClient.from_env()


def test_from_env_requires_api_key(monkeypatch):
    monkeypatch.setenv("BO_MCP_API_URL", "http://api:8000")
    monkeypatch.delenv("BO_MCP_API_KEY", raising=False)
    with pytest.raises(BoMcpClientError, match="BO_MCP_API_KEY"):
        BoMcpClient.from_env()


def test_api_key_header_is_set():
    client = BoMcpClient(base_url="http://api:8000", api_key="key-123")
    assert client.session.headers["X-API-Key"] == "key-123"


def test_client_guidance_distinguishes_replicates_from_rejections():
    guidance = " ".join((BoMcpClient.__doc__ or "").split())

    assert "Do not reject a suggestion solely because" in guidance
    assert "may intentionally recommend a replicate" in guidance
    assert "force=True" in guidance
    assert "does not exclude" in guidance


def test_create_campaign_sends_idempotency_key():
    client, fake = _client(
        _FakeResponse(payload={"success": True, "campaign_id": "c1"})
    )
    result = client.create_campaign({"objectives": []}, idempotency_key="idem-1")
    assert result["campaign_id"] == "c1"
    call = fake.calls[0]
    assert call["method"] == "POST"
    assert call["url"].endswith("/api/v1/campaigns")
    assert call["headers"]["Idempotency-Key"] == "idem-1"
    assert call["json"] == {"intake": {"objectives": []}}


def test_submit_results_posts_to_campaign_scoped_path():
    client, fake = _client(_FakeResponse(payload={"success": True}))
    client.submit_results("c1", results=[{"x": 1}], idempotency_key="idem-2")
    call = fake.calls[0]
    assert call["url"].endswith("/api/v1/results/c1")
    assert call["headers"]["Idempotency-Key"] == "idem-2"
    # Exact equality: ``force`` must be absent rather than falsy, because the
    # server's result schema forbids extra keys on versions predating it.
    assert call["json"] == {"results": [{"x": 1}], "source": "api"}


def test_submit_results_forwards_force_override():
    client, fake = _client(_FakeResponse(payload={"success": True}))
    client.submit_results(
        "c1", results=[{"x": 1}], idempotency_key="idem-2", force=True
    )

    assert fake.calls[0]["json"]["force"] is True


def test_get_results_reads_campaign_scoped_result_rows():
