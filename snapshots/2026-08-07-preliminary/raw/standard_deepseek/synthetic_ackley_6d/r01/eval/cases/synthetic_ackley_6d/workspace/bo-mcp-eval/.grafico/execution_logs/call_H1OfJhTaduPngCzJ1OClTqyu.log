                        )
                else:
                    failure_reason = str(eval_result.get("error", "unknown"))
                    alert(
                        f"eval={evaluation_index} FAILED: {failure_reason}"
                    )
                    try:
                        client.update_suggestion_status(psug_id, "rejected")
                    except Exception:
