   330	def run_campaign(
   331	    campaign_id: str | None = None,
   332	    *,
   333	    max_attempts: int = MAX_ATTEMPTS,
   334	    poll_s: int = DEFAULT_POLL_S,
   335	    heartbeat_s: int = DEFAULT_HEARTBEAT_S,
   336	    stop_file: str = DEFAULT_STOP_FILE,
   337	) -> tuple[str, list[dict[str, Any]]]:
   338	    """
   339	    Run the direct arylation BO campaign.
   340	
   341	    Enforces exactly 60 total attempted oracle evaluations (including failures) across all runs/resumes.
   342	    Returns complete attempt history from artifact for final reporting.
   343	
   344	    Returns:
   345	        Tuple of (campaign_id, all_attempts)
   346	    """
   347	    # Initialize Logfire
   348	    try:
   349	        from grafico.core.logfire_config import configure_logfire
   350	        configure_logfire()
   351	        logfire.instrument_requests()
   352	    except Exception:
   353	        pass  # Logfire optional
   354	
   355	    log_event(f"Direct Arylation BO Campaign starting (marker={MARKER}, nonce={NONCE})")
   356	
   357	    # Initialize BO-MCP client
   358	    try:
   359	        client = BoMcpClient.from_env()
   360	    except BoMcpClientError as e:
   361	        log_alert(f"Failed to initialize BO-MCP client: {e}")
   362	        raise
   363	
   364	    # Create or resume campaign
   365	    final_campaign_id = create_or_resume_campaign(client, campaign_id)
   366	    state = CampaignState(final_campaign_id)
   367	
   368	    # If resuming, load existing attempt history from artifact
   369	    if campaign_id:
   370	        prior_attempts = get_attempt_history(final_campaign_id)
   371	        log_event(f"Loaded {len(prior_attempts)} prior attempts from artifact")
   372	        # Note: We track these separately from state.evaluated (which is this run only)
   373	        # The budget check uses count_attempts() which reads from artifact
   374	
   375	    # Run optimization loop
   376	    stop_path = Path(stop_file).resolve()
   377	    run_optimization_loop(
   378	        client,
   379	        final_campaign_id,
   380	        state,
   381	        max_attempts=max_attempts,
   382	        poll_s=poll_s,
   383	        heartbeat_s=heartbeat_s,
   384	        stop_file=stop_path,
   385	    )
   386	
   387	    # Final report: use complete attempt history from artifact
   388	    all_attempts = get_attempt_history(final_campaign_id)
   389	    summary = compute_summary(all_attempts)
   390	    print_campaign_report(final_campaign_id, all_attempts, summary)
   391	    print_final_summary_line(final_campaign_id, summary)
   392	
   393	    # Pause campaign at end (don't terminate)
   394	    try:
   395	        current_status = client.get_campaign(final_campaign_id).get("status")
   396	        if current_status == "running":
   397	            client.lifecycle(final_campaign_id, action="pause")
   398	            log_event("Campaign paused for resumption")
   399	    except (BoMcpClientError, BoMcpOperationError) as e:
   400	        log_alert(f"Failed to pause campaign: {e}")
   401	
   402	    return final_campaign_id, all_attempts


