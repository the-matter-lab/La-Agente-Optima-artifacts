   292	def create_or_resume_campaign(
   293	    client: BoMcpClient,
   294	    campaign_id: str | None = None,
   295	) -> str:
   296	    """Create a new campaign or return existing campaign ID."""
   297	    if campaign_id:
   298	        # Verify campaign exists and has our marker
   299	        try:
   300	            campaign = client.get_campaign(campaign_id)
   301	            if MARKER not in campaign.get("name", ""):
   302	                log_alert(f"Campaign {campaign_id} does not have required marker {MARKER}")
   303	            log_event(f"Resuming existing campaign: {campaign_id}")
   304	            return campaign_id
   305	        except (BoMcpClientError, BoMcpOperationError) as e:
   306	            log_alert(f"Failed to get campaign {campaign_id}: {e}")
   307	            raise
   308	
   309	    # Create new campaign
   310	    intake = build_intake()
   311	    validate_intake(intake)
   312	
   313	    idempotency_key = make_idempotency_key("create", MARKER, NONCE)
   314	    try:
   315	        response = client.create_campaign(intake, idempotency_key=idempotency_key)
   316	        new_campaign_id = response.get("campaign_id")
   317	        if not new_campaign_id:
   318	            raise BoMcpOperationError("No campaign_id in response", response)
   319	        log_event(f"Created new campaign: {new_campaign_id}")
   320	        return new_campaign_id
   321	    except BoMcpOperationError as e:
   322	        if e.payload.get("idempotency_replay"):
   323	            # Campaign already exists, find it
   324	            log_event("Campaign creation replayed; querying for existing campaign")
   325	            # We'd need to query campaigns to find it, but for simplicity error out
   326	            raise BoMcpClientError("Idempotency replay but no campaign_id returned")
   327	        raise
